rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public read access for images in public folders
    match /places/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /submissions/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImageUnder5MB();
    }

    match /reviews/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImageUnder5MB();
    }
  }
}
