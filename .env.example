# Copy this file to `.env.local` and fill in real values locally.
# Never commit `.env.local` or any file containing real credentials.
#
# Firebase will be added in a later step. Placeholders only:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Default launch region (display only; not an application-wide restriction)
VITE_DEFAULT_REGION=Malappuram
